<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef Name="NC_WelcomeBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <tickerType>Rare</tickerType>
    <size>(1,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>10</pathCost>
    <designationCategory>Furniture</designationCategory>
    <costList>
      <WoodLog>50</WoodLog>
      <Steel>15</Steel>
      <Cloth>10</Cloth>
    </costList>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Mass>8</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>4</Beauty>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>7</glowRadius>
        <glowColor>(214,164,110,0)</glowColor>
      </li>
    </comps>
  </ThingDef>
  <ThingDef Name="NC_ToolBase" ParentName="ResourceBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <stackLimit>1</stackLimit>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.65</drawSize>
    </graphicData>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>1</Mass>
      <Flammability>0.7</Flammability>
      <WorkToMake>1200</WorkToMake>
      <MarketValue>30</MarketValue>
    </statBases>
    <costList>
      <Cloth>15</Cloth>
      <WoodLog>10</WoodLog>
      <Steel>5</Steel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>CraftingSpot</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>
  <JobDef>
    <defName>NC_CollectTool</defName>
    <modExtensions><li Class="NeighborCourtyards.AssistantSupplyJob" /></modExtensions>
    <driverClass>NeighborCourtyards.JobDriver_CollectTool</driverClass>
    <reportString>正在领取TargetA。</reportString>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>
  <JobDef>
    <defName>NC_Arrive</defName>
    <driverClass>NeighborCourtyards.JobDriver_Arrive</driverClass>
    <reportString>正在前往TargetA。</reportString>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>
</Defs>
